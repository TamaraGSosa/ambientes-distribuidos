# Configuracion de PostgreSQL Primary / Replica (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_primary_pass
POSTGRES_DB=tp8_db

REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_pass

# Puertos expuestos en el host (evita conflicto con 5432 local)
PRIMARY_PORT=5433
REPLICA_PORT=5434
