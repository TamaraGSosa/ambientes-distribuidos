# Aplicacion NestJS
PORT=3000
NODE_ENV=development

# Base de datos Primary (Escritura: INSERT, UPDATE, DELETE)
DB_PRIMARY_HOST=localhost
DB_PRIMARY_PORT=5433
DB_PRIMARY_USER=postgres
DB_PRIMARY_PASSWORD=postgres_primary_pass
DB_PRIMARY_NAME=tp8_db

# Base de datos Replica (Lectura: SELECT)
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=5434
DB_REPLICA_USER=postgres
DB_REPLICA_PASSWORD=postgres_primary_pass
DB_REPLICA_NAME=tp8_db
