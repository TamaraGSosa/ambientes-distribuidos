# Puerto HTTPS del servidor (sin endpoint HTTP alternativo)
PORT=3443

# Rutas a los certificados TLS locales (relativas a TP9/servidor o absolutas)
TLS_KEY_PATH=./certs/server.key
TLS_CERT_PATH=./certs/server.crt

# Secreto para firma y verificación de tokens JWT (reemplazar en .env)
JWT_SECRET=cambiar_por_secreto_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=15m
